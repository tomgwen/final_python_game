# =========================================================
# 基本設定 (與主程式對齊)
# =========================================================
SCREEN_WIDTH = 1280
SCREEN_HEIGHT = 700
FPS = 60

BLACK = (10, 10, 12)
TEXT_COLOR = (210, 210, 210)
GOLD_LIGHT = (255, 204, 108)
GROUND_COLOR = (28, 35, 30)

# =========================================================
